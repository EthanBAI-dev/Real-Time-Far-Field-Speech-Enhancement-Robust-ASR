# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# 体积管控：C: 盘只剩 18 GB，这些目录一律不入库（见 docs/ISSUES.md I-04）
data/
models/
checkpoints/
cache/

# 评测产物：json 指标入库（是作品集的一部分），音频与大图不入库
results/**/*.wav
results/**/*.flac
results/**/*.npz
!results/**/*.json
!results/**/*.md

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 构建产物：pack_for_colab.py 的输出，随时可重新生成，不该入库造成噪音 diff
dist/

# Colab 回传的原始压缩包：内容已经解压分流到 models/ 和 results/，
# 压缩包本身没必要入库
colab_outputs.zip

# Colab 回传的数据包（几百 MB，解压后进 data/ 与 models/，包本身不入库）
testset.zip
output-*.zip
